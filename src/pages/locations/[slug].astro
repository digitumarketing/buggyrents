---
import Location from '@/components/templates/Location.astro';
import { locations } from '@/data/locations';
import { withNearby } from '@/data/locationPages';
export function getStaticPaths() {
  return locations.map(l => ({ params: { slug: l.slug }, props: { data: withNearby(l) } }));
}
const { data } = Astro.props;
---
<Location data={data} />
