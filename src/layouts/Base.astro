---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingActions from '@/components/FloatingActions.astro';
import { site, businessId } from '@/data/site';
import { clusters } from '@/data/clusters';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  vehicle?: string;
  duration?: string;
  price?: number;
}
const { title, description, image = '/assets/og/default.jpg', noindex = false, vehicle, duration, price } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;

/* Which cluster this page belongs to, resolved at build time and sent with every lead
   event. Doing it here rather than in the browser means the report can group leads by
   service without anyone maintaining a second list of path prefixes in JavaScript. */
const leadCluster = clusters.find(c => Astro.url.pathname.startsWith(c.path))?.key ?? 'other';

const localBusiness = {
  '@context': 'https://schema.org',

  /* Was 'TouristAttraction' alone until 5 Sep 2026, and the variable has been called
     localBusiness the whole time, which is what it should always have been.
     TouristAttraction is a subtype of Place, not of LocalBusiness: it is not eligible
     for local business rich results, and priceRange below is not one of its
     properties, so the site was declaring a property its own type does not have.
     CLAUDE.md §6 has specified LocalBusiness since it was written; only the code
     disagreed. The array keeps the attraction reading, which is fair for a riding
     base at the edge of the dunes, and adds the type Google actually reads. */
  '@type': ['LocalBusiness', 'TouristAttraction'],

  /* Every other node describing this business points at this id. See site.ts. */
  '@id': businessId,

  name: site.name,
  legalName: site.legalName,
  description: site.tagline,
  url: site.domain,
  telephone: site.phoneRaw,
  email: site.email,
  image: new URL('/assets/og/default.jpg', site.domain).href,
  logo: new URL('/icon-512.png', site.domain).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.district}`,
    addressLocality: site.address.city,
    addressCountry: site.address.country
  },

  /* The base sits outside the city on the Dubai to Hatta road, so a search engine
     cannot infer the location from the locality alone. Coordinates are already in
     Site settings because the map embed uses them. */
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng
  },

  /* Dubai pickup is free and the outer emirates are quoted, so both are served and
     only Dubai is named as the city. Nothing broader is claimed. */
  areaServed: [
    { '@type': 'City', name: 'Dubai' },
    { '@type': 'Country', name: 'United Arab Emirates' }
  ],

  hasMap: site.maps.link,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: site.hours.opens,
    closes: site.hours.closes
  },
  priceRange: 'AED 75 to AED 2200',

  /* What the business sells, read from src/data/clusters.ts so this is not a fifth
     copy of the cluster list. An answer engine asked what Buggy Rents offers can
     read this instead of inferring it from the navigation. */
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${site.name} desert rides and safaris`,
    itemListElement: clusters.map(c => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: c.name,
        description: c.description,
        url: new URL(c.path, site.domain).href,
        provider: { '@id': businessId }
      }
    }))
  },

  /* sameAs is how Google links this site, the Google Business Profile and the five
     social accounts into a single entity. Leaving it out was throwing away a real
     local ranking signal for accounts the business already runs. */
  sameAs: site.social.map(s => s.url)
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.domain).href} />
  <meta name="twitter:card" content="summary_large_image" />

  {/* These four were linked before the files existed, so every page was firing
      four 404s and showing the browser's blank default icon. Generated from the
      brand mark: a white buggy on the orange plate, which is the only version
      still readable at 16px. favicon.ico stays because several crawlers, Google's
      search result icon among them, still ask for it before anything else. */}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#FF6600" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

  {/* GA4 IS NOT CONFIGURED HERE ANY MORE. Removed 5 Sep 2026 at the client's
      direction: every tag, GA4 included, now lives in GTM container so that pixels,
      conversions and consent are managed in one place without a deploy.

      This reverses the decision recorded in CLAUDE.md launch item 2, and the reasoning
      that decision was built on has not gone away, so read it before putting a property
      back in this file. It was: an audit can assert a property is configured exactly
      once in built HTML and cannot see inside a container, so hardcoding made tracking
      verifiable on every deploy. What replaced that guarantee is narrower and worth
      knowing. The build now checks that a container loads on every page and that no GA4
      property is configured in the HTML alongside it, which is what caused the 3 Sep
      double-count. It cannot check that the container still contains a GA4 tag.

      The practical consequence: deleting the GA4 tag inside GTM stops all measurement
      and nothing in this repo will notice. Confirm in GA4 Realtime after any container
      publish. docs/GTM-SETUP.md is the container's build sheet.

      DO NOT re-add a gtag loader or a gtag('config') call here. One property configured
      in both the HTML and the container is exactly the bug that doubled every figure in
      the client's reports from 3 to 4 Sep 2026, and the analytics audit now fails the
      build on it rather than warning. */}

  {/* Lead events. Added 5 Sep 2026, and until then this site measured nothing.
      GA4 was configured and fired a pageview, and that was all: not one click on the
      WhatsApp button, the call button or the contact form reached it, so every enquiry
      the site had ever produced was invisible and no report could say whether organic
      traffic converted at all.

      ONE DELEGATED LISTENER, NOT AN onclick PER COMPONENT. WhatsApp and phone links are
      rendered by FloatingActions, the header, the footer, six templates and any CMS rich
      text field the client types a link into. A listener per component would have missed
      the CMS ones entirely and would need adding again to every component built after
      this. Delegating from the document catches all of them, including links that do not
      exist yet.

      PROD-only, for the same reason as GA4 above: dev and audit runs stay out of the
      client's data. The audit reads the built HTML rather than executing it, so it can
      still see this block. */}
  {import.meta.env.PROD && (
    <script is:inline set:html={`(function(){
  var cluster=${JSON.stringify(leadCluster)};
  /* Pushed to the dataLayer rather than called on gtag, because GA4 now lives in GTM
     and there is no gtag on the page. dataLayer is initialised here rather than assumed:
     this block can run before the container snippet, and a push made before GTM loads is
     replayed by GTM when it does, so an early click is not lost. */
  window.dataLayer=window.dataLayer||[];
  function lead(name,extra){
    var p={event:name,lead_page:location.pathname,lead_cluster:cluster};
    if(extra)for(var k in extra)p['lead_'+k]=extra[k];
    window.dataLayer.push(p);
  }
  /* Exposed so the contact form can report itself. Its primary button opens WhatsApp
     with window.open rather than following an href, so the delegated handler below
     cannot see it, and that button is the single most valuable action on the site. */
  window.brLead=lead;
  document.addEventListener('click',function(e){
    var t=e.target;
    var a=t&&t.closest?t.closest('a[href]'):null;
    if(!a)return;
    var h=a.getAttribute('href')||'';
    if(h.indexOf('wa.me')>-1||h.indexOf('api.whatsapp.com')>-1)lead('whatsapp_click',{method:'link'});
    else if(h.slice(0,4)==='tel:')lead('call_click',{method:'link'});
    /* The email address is in the footer of all 75 pages and on the contact page.
       It is a real enquiry route and was being counted as nothing. */
    else if(h.slice(0,7)==='mailto:')lead('email_click',{method:'link'});
    /* Not an enquiry, but the strongest local-intent signal on the site: somebody
       checking where the base actually is before they book. Worth having when the
       question becomes why sessions are not turning into messages. */
    else if(h.indexOf('local.google.com')>-1||h.indexOf('google.com/maps')>-1||h.indexOf('goo.gl/maps')>-1)lead('directions_click',{method:'link'});
  },true);
})();`} />
  )}

  {/* Google Tag Manager and any pasted head code, from Site settings in the CMS.
      PROD-only for the same reason as GA4 above: keep dev and audit runs out of the
      client's data. Empty settings inject nothing, so the default build is unchanged.

      pastedGtm suppresses this block when the pasted code already loads GTM, so
      filling in both fields cannot load the container twice. See site.ts. */}
  {import.meta.env.PROD && site.tracking.gtmId && !site.tracking.pastedGtm && (
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${site.tracking.gtmId}');`} />
  )}
  {import.meta.env.PROD && site.tracking.headCode && <Fragment set:html={site.tracking.headCode} />}

  <slot name="head" />
</head>
<body>
  {import.meta.env.PROD && site.tracking.gtmId && !site.tracking.pastedGtm && (
    <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${site.tracking.gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
  )}
  {import.meta.env.PROD && site.tracking.bodyCode && <Fragment set:html={site.tracking.bodyCode} />}
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <FloatingActions vehicle={vehicle} duration={duration} price={price} />
</body>
</html>
