---
/* Red dune desert safari, and where a Dubai desert safari actually goes.
 *
 * WHY THIS PAGE EXISTS
 * Three keywords with real volume and low difficulty describe the same question,
 * and the site answered none of them: red dune desert safari dubai (1,000, KD 22),
 * dubai desert safari location (720, KD 20) and desert safari dubai location map
 * (110, KD 21). All three are somebody asking where they are being taken. That is
 * one page, not three.
 *
 * It uses the dbr-location template rather than the cluster one because it is a
 * place page, not a product page: there is no package called "red dune safari",
 * and inventing one would have made it the doorway page CLAUDE.md warns about.
 * Every safari we run goes to Lahbab, so this page describes the destination and
 * sends the booking to the packages.
 *
 * Location.astro takes an optional `parent` so the breadcrumb reads
 * Home / Desert Safari Dubai / Red Dunes rather than claiming to sit under
 * /locations/, which holds pickup areas and is a different thing. */
import Location from '@/components/templates/Location.astro';
import type { LocationData } from '@/components/templates/Location.astro';
import { SAFARI_BASE } from '@/data/safariPages';
import { allSafaris } from '@/data/safari';
import { transfers } from '@/data/extras';
import { site } from '@/data/site';
import { pageTitle } from '@/data/seo';
import { buggies, quads, fromPrice } from '@/data/vehicles';

const safariFrom = Math.min(...allSafaris.map(s => s.price));
const buggyFrom = Math.min(...buggies.map(fromPrice));
const quadFrom = Math.min(...quads.map(fromPrice));
const money = (n: number) => n.toLocaleString('en-US');

const data: LocationData = {
