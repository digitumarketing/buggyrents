---
/* Homepage, mirrors the 13-section structure of BuggyRents-home.html,
   adapted to the Phase 1 scope (no balloon, camel or combos yet). */
import { img } from '@/data/images';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import TrustStrip from '@/components/home/TrustStrip.astro';
import Editorial from '@/components/home/Editorial.astro';
import Safari from '@/components/home/Safari.astro';
import PricingGuide from '@/components/home/PricingGuide.astro';
import TourVariety from '@/components/home/TourVariety.astro';
import Spotlight from '@/components/home/Spotlight.astro';
import LongFormReader from '@/components/LongFormReader.astro';
import LinkClusters from '@/components/home/LinkClusters.astro';
import Faq from '@/components/home/Faq.astro';
import Reviews from '@/components/home/Reviews.astro';
import VehicleCard from '@/components/VehicleCard.astro';
import { buggies, quads } from '@/data/vehicles';
import { buggyIntro, quadIntro } from '@/data/home';
import { homeLongForm } from '@/data/longform';
---
{/* TITLE AND DESCRIPTION REWRITTEN 7 Sep 2026 AGAINST SEARCH CONSOLE, not against
    the keyword research. The research in CLAUDE.md §5 is about volume; this is about
    the words the people who actually reach this site type, and the two disagree.

    Search Console's first month, recorded in docs/reports/2026-09-baseline.md, shows
    this page ranking for the entire "buggy rental" family and nothing else coming
    close: buggy rental dubai at 134 impressions, plus buggy rentals dubai, buggy
    rental in dubai, dubai buggy rental and dune buggy rental. Every one of them
    contains RENTAL or HIRE. The page said "Tours", used the word rental five times in
    total, and used "hire" not once. Google was ranking it at position 20 on the
    strength of the domain name, buggyrents.com, rather than on anything written here.

    The homepage is the page being fixed rather than the buggy pillar because Search
    Console says the homepage is what Google chose for these queries: the pillar draws
    a single impression on them. Fighting that choice is slower than serving it.

    CANNIBALISATION CLOSED 4 Nov 2026. October's Search Console showed both pages
    competing for "dune buggy rental dubai": homepage at 12.2, the buggy pillar at 26.7,
    because the pillar's title and h1 also opened on "Dune Buggy Rental Dubai". The
    pillar now targets the head term and the tour/ride intents (dune buggy dubai,
    dune buggy tour dubai, dune buggy ride dubai) and links here with a "buggy rental
    in Dubai" anchor. This page owns the rental and hire family alone. docs/KEYWORDS.md
    §2 records the split; keep the pillar's title and h1 free of "rental". */}
<Base
  title="Dune Buggy Rental Dubai | Quad Bike and Dirt Bike Hire"
  description="Buggy rental and hire in Dubai from AED 300 per buggy, plus quad bike, ATV and KTM dirt bike rental in the Lahbab red dunes. Helmet and guide included."
>
  <!-- 1 -->
  <Hero />

  <!-- 2 -->
  <TrustStrip />

  <!-- 3 -->
  <section class="section" id="fleet-buggy">
    <div class="shell">
      <p class="eyebrow">Dune buggy rental</p>
      <h2>Buggy rental Dubai: {buggies.length} buggies, one price per vehicle</h2>
      <p class="lede">Polaris if it is your first time behind the wheel. Can-Am if it is not. The Maverick R if you already know exactly what you are asking for.</p>
      <div class="grid grid--3" style="margin-top:2rem">
        {buggies.map(v => <VehicleCard vehicle={v} base="/dune-buggy-dubai/" />)}
      </div>
    </div>
  </section>

  <!-- 4 -->
  <Editorial {...buggyIntro} tone="sand" />

  <!-- 5 -->
  <section class="section" id="fleet-quad">
    <div class="shell">
      <p class="eyebrow">Quad bike rental</p>
      <h2>Six quads, split by riding area</h2>
      <p class="lede">From a fenced zone for six-year-olds to open-desert Raptor 700 runs. Five durations on every machine.</p>
      <div class="grid grid--3" style="margin-top:2rem">
        {quads.map(v => <VehicleCard vehicle={v} base="/quad-bike-dubai/" />)}
      </div>
    </div>
  </section>

  <!-- 6 -->
  <Editorial {...quadIntro} flip tone="sand" />

  <!-- 7 -->
  <Safari />

  <!-- 8 -->
  <PricingGuide />

  <!-- 9 -->
  <TourVariety />

  <!-- 10 -->
  <Spotlight />

  <!-- 11 -->
  <LinkClusters />

  <!-- 12 -->
  <LongFormReader {...homeLongForm} />

  <!-- 13 -->
  <Faq />

  <!-- 14 -->
  <Reviews />
</Base>
