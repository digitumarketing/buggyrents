---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingActions from '@/components/FloatingActions.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  vehicle?: string;
  duration?: string;
  price?: number;
}
const { title, description, image = '/assets/og/default.jpg', noindex = false, vehicle, duration, price } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: site.name,
  description: site.tagline,
  url: site.domain,
  telephone: site.phoneRaw,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.district}`,
    addressLocality: site.address.city,
    addressCountry: site.address.country
  },
  hasMap: site.maps.link,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: site.hours.opens,
    closes: site.hours.closes
  },
  priceRange: 'AED 75 to AED 2200',
  /* sameAs is how Google links this site, the Google Business Profile and the five
     social accounts into a single entity. Leaving it out was throwing away a real
     local ranking signal for accounts the business already runs. */
  sameAs: site.social.map(s => s.url)
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.domain).href} />
  <meta name="twitter:card" content="summary_large_image" />

  {/* These four were linked before the files existed, so every page was firing
      four 404s and showing the browser's blank default icon. Generated from the
      brand mark: a white buggy on the orange plate, which is the only version
      still readable at 16px. favicon.ico stays because several crawlers, Google's
      search result icon among them, still ask for it before anything else. */}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#FF6600" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Instrument+Sans:wght@400;500;600&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

  {/* Google Analytics 4. Wrapped in import.meta.env.PROD on purpose: without it
      every local dev page view and every audit run would land in the client's
      reports as real traffic, and the first month of data is the one they will
      judge the site on. is:inline stops Astro bundling it, which is what Google
      expects for gtag. */}
  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HKVDWC923V"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-HKVDWC923V');
      </script>
    </>
  )}

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <FloatingActions vehicle={vehicle} duration={duration} price={price} />
</body>
</html>
