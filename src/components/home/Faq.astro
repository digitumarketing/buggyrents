---
import { faqs } from '@/data/home';
import { site, waLink, bookMessage } from '@/data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<section class="section" id="faq">
  <div class="shell faq">
    <div class="faq__head">
      <p class="eyebrow">Before you book</p>
      <h2>Straight answers to the usual questions</h2>
      <p class="lede">Not here? Message us on WhatsApp, a real person replies, usually within a few minutes.</p>
      <a class="btn btn--wa" href={waLink(bookMessage())}>WhatsApp {site.phone}</a>
    </div>
    <div class="faq__list">
      {faqs.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span class="faq__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="faq__q">{f.q}</span>
            <svg class="faq__ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq { display: grid; gap: clamp(1.75rem, 4vw, 3.5rem); grid-template-columns: minmax(0.78fr) minmax(0, 1.22fr); align-items: start; }
  .faq__head .btn { margin-top: 1.4rem; }
  .faq__list { border: 1px solid var(--c-line); border-radius: var(--radius-lg); overflow: hidden; background: #fff; }
  .faq__list details + details { border-top: 1px solid var(--c-line-soft); }
  .faq__list summary { display: flex; align-items: center; gap: .9rem; padding: 1.05rem 1.2rem; cursor: pointer; list-style: none; }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary:hover { background: var(--c-sand-soft); }
  .faq__n { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xs); color: var(--c-orange); flex: none; }
  .faq__q { font-family: var(--font-display); font-weight: 700; color: var(--c-navy); flex: 1; font-size: var(--fs-sm); }
  .faq__ico { flex: none; color: var(--c-ink-soft); transition: transform var(--dur-fast); }
  details[open] .faq__ico { transform: rotate(180deg); }
  .faq__list p { padding: 0 1.2rem 1.2rem 3.05rem; font-size: var(--fs-sm); color: var(--c-ink-muted); }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; } .faq__list p { padding-left: 1.2rem; } }
</style>
