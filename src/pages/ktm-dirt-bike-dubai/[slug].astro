---
import Cluster from '@/components/templates/Cluster.astro';
import { dirtbikes } from '@/data/vehicles';
import { tourData } from '@/data/tours';
export function getStaticPaths() {
  return dirtbikes.map(v => ({ params: { slug: v.slug }, props: { data: tourData(v) } }));
}
const { data } = Astro.props;
---
<Cluster data={data} />
