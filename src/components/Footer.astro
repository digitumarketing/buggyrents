---
import { site } from '@/data/site';
import { footerNav } from '@/data/nav';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="shell ftr__top">
    <div class="ftr__brand">
      <img src="/assets/brand/buggy-rents-white.webp" alt="Buggy Rents" width="200" height="53" class="ftr__logo" />
      <p class="ftr__blurb">Self-drive dune buggies, quad bikes and KTM dirt bikes across the Dubai desert. Guided routes, full safety gear, hotel pickup on request.</p>
      <ul role="list" class="ftr__contact">
        <li><a href={`tel:${site.phoneRaw}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.maps.link} target="_blank" rel="noopener">{site.address.full}</a></li>
        <li>Open daily {site.hours.opens}–{site.hours.closes}</li>
      </ul>
      <p class="ftr__award">TripAdvisor Travellers' Choice</p>

      {site.social.length > 0 && (
        <ul role="list" class="ftr__social" aria-label="Buggy Rents on social media">
          {site.social.map(s => (
            <li>
              <a href={s.url} target="_blank" rel="noopener me" aria-label={`Buggy Rents on ${s.name}`}>
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="ftr__cols">
      {Object.entries(footerNav).map(([heading, links]) => (
        <div>
          <h3 class="ftr__h">{heading}</h3>
          <ul role="list" class="ftr__list">
            {links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="shell ftr__bottom">
    <p>© {year} {site.legalName}. All rights reserved.</p>
    <p class="ftr__note">Prices in AED and include VAT where applicable.</p>
    <p class="ftr__credit">
      Designed &amp; Marketing By
      <a href={site.agency.url} target="_blank" rel="noopener">{site.agency.name}</a>
    </p>
  </div>
</footer>

<style>
  /* rel="me" alongside schema sameAs: both tell a crawler these accounts and this
     site are the same business. */
  .ftr__social { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; padding: 0; list-style: none; }
  .ftr__social a { display: inline-flex; align-items: center; min-height: 34px; padding: 0 .85em;
    border: 1px solid rgba(255,255,255,.28); border-radius: 999px;
    font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xs);
    color: rgba(255,255,255,.86); text-decoration: none; transition: all .16s ease; }
  .ftr__social a:hover { background: rgba(255,255,255,.14); border-color: #fff; color: #fff; }

  .ftr { background: var(--c-navy); color: rgba(255,255,255,.78); }
  .ftr a { color: inherit; text-decoration: none; }
  .ftr a:hover { color: #fff; text-decoration: underline; }

  .ftr__top { display: grid; gap: clamp(2rem, 4vw, 3.5rem); grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr); padding-block: clamp(2.5rem, 5vw, 4rem); }
  .ftr__logo { height: 44px; width: auto; }
  .ftr__blurb { margin-top: 1rem; font-size: var(--fs-sm); max-width: 42ch; }
  .ftr__contact { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: .4rem; font-size: var(--fs-sm); }
  .ftr__award { margin-top: 1.25rem; display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xs); letter-spacing: .06em; text-transform: uppercase; color: var(--c-gold); border: 1px solid rgba(255,199,87,.4); padding: .45em 1em; border-radius: var(--radius-pill); }

  .ftr__cols { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  .ftr__h { font-size: var(--fs-xs); letter-spacing: .12em; text-transform: uppercase; color: #fff; margin-bottom: .9rem; }
  .ftr__list { list-style: none; padding: 0; margin: 0; display: grid; gap: .55rem; font-size: var(--fs-sm); }

  .ftr__bottom { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; justify-content: space-between; padding-block: 1.25rem; border-top: 1px solid rgba(255,255,255,.14); font-size: var(--fs-xs); }
  .ftr__note { opacity: .7; }
  /* The credit sits on the same row as the copyright and the VAT note. It is
     underlined rather than coloured because the footer is navy and the brand
     orange fails contrast on it at this size. */
  .ftr__credit { opacity: .7; }
  .ftr__credit a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .ftr__credit a:hover { color: var(--c-gold); }

  @media (max-width: 860px) { .ftr__top { grid-template-columns: 1fr; } }
</style>
