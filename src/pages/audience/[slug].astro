---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import LongFormReader from '@/components/LongFormReader.astro';
import VehicleCard from '@/components/VehicleCard.astro';
import Faq from '@/components/home/Faq.astro';
import { audiences } from '@/data/audiences';
import { buggies, quads } from '@/data/vehicles';
import { site } from '@/data/site';

export function getStaticPaths() {
  return audiences.map(a => ({ params: { slug: a.slug }, props: { aud: a } }));
}
const { aud } = Astro.props;
const picks = [buggies[0], buggies[1], quads[0]];

const blocks = [
  { h: `${aud.name}: what to book`,
    html: `<p class="lf-lead">${aud.intro}</p><p>Recommended vehicles: <span class="pill">${aud.vehicles}</span>. Every price is per vehicle, so a 2-seater at AED 300 covers two people rather than charging each of you.</p>` },
  { h: 'How the session runs',
    html: `<p class="lf-lead">Arrive at the Al Awir base, sign in, get fitted for a helmet and take the briefing. Nobody drives off until harnesses are checked.</p><p>The route starts on flat sand to let everyone find the controls, then moves onto progressively steeper dune faces. A lead guide sets the pace and a sweep stays at the back so the group never splits.</p>` },
  { h: 'Ages, licences and requirements',
    html: `<ul><li>Buggy drivers must be 18 or over — passengers can be any age</li><li>Kids quads run from age 6 in a fenced area</li><li>Quads in the boundary area from 12, open desert from 14</li><li>Raptor 700cc and KTM 450 are 18+ with rider screening</li></ul><p>No UAE or international driving licence is needed on guided routes.</p>` },
  { h: 'Pairing it with the rest of the day',
    html: `<p class="lf-lead">Most groups add a <a href="/desert-safari-dubai-deals/">desert safari</a> and BBQ camp stop after the ride rather than booking two separate trips.</p><p>Pickup runs from across Dubai — see <a href="/locations/dune-buggy-near-downtown-dubai/">Downtown</a>, <a href="/locations/dune-buggy-near-dubai-marina/">Marina</a> and <a href="/locations/dune-buggy-from-sharjah/">Sharjah</a> routes for drive times.</p>` }
];
---
<Base
  title={`${aud.name} | Dubai Desert Tours | Buggy Rents`}
  description={`${aud.name} — ${aud.pitch}. ${aud.vehicles}. Guided dune buggy and quad biking in the Lahbab red dunes. WhatsApp ${site.phone}.`}
>
  <Hero
    eyebrow={`For ${aud.short.toLowerCase()} · Lahbab red dunes`}
    heading={aud.name}
    taglineEm={aud.pitch}
    tagline={`— ${aud.vehicles}`}
  />

  <section class="section">
    <div class="shell">
      <p class="eyebrow">Recommended</p>
      <h2>What we suggest for {aud.short.toLowerCase()}</h2>
      <div class="grid grid--3" style="margin-top:2rem">
        {picks.map(v => <VehicleCard vehicle={v} base={v.category === 'buggy' ? '/dune-buggy-dubai/' : '/quad-bike-dubai/'} />)}
      </div>
    </div>
  </section>

  <LongFormReader
    eyebrow={`${aud.short} guide`}
    heading={`${aud.name} in the Dubai desert`}
    intro={aud.intro}
    blocks={blocks}
    closeHeading={`Plan a ride for ${aud.short.toLowerCase()}`}
    closeLede="Send your date and group size and we will come back with availability, the total in AED and a pickup plan."
  />

  <Faq />
</Base>
