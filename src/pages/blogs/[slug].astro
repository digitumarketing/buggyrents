---
/* Blog article — markup matched to templates/BuggyRents-5-quadbike-mistakes.html:
     1 hero        breadcrumb, h1, deck, meta pills and two buttons on the left,
                   figure on the right, large ghosted word behind
     2 wrap        TOC aside / article body / help + related asides
     3 author      divider, avatar, name, bio
     4 final CTA   divider, kicker, h2, copy, two buttons

   The body follows the reference order exactly: intro, Key takeaways as a normal
   h2 with a list, the content sections, How to book, the comparison table, then
   Frequently asked questions as h3 and paragraph pairs rather than accordions,
   and a closing line. The table of contents is generated from the rendered h2
   and h3 tags, which is how the reference builds it. */
import '@/styles/blog.css';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { img } from '@/data/images';
import { site, waLink } from '@/data/site';
import { allPosts, categoryLabel, type Post } from '@/data/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map(p => ({ params: { slug: p.id }, props: { post: p, posts } }));
}
interface Props { post: Post; posts: Post[] }
const { post: entry, posts } = Astro.props;
const p = entry.data;

/* The body is Markdoc now, so Astro renders it and hands back the headings it
   found. That list used to be built by regex over hand-written HTML; letting the
   renderer report its own headings means the contents can never drift from the
   article. Heading ids come from markdoc.config.mjs. */
const { Content, headings } = await render(entry);

const fig = img(p.image, p.subject);
const url = `${site.domain}/blogs/${entry.id}/`;
const cat = categoryLabel(p.category);

const slugify = (s: string) => s.toLowerCase().replace(/<[^>]*>/g, '')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

type TocEntry = { id: string; text: string; level: 2 | 3 };
const toc: TocEntry[] = [
  { id: 'key-takeaways', text: 'Key takeaways', level: 2 },
  ...headings
    .filter(h => h.depth === 2 || h.depth === 3)
    .map(h => ({ id: h.slug, text: h.text, level: h.depth as 2 | 3 }))
];

/* Takeaways and the FAQ block sit outside the Markdoc body, so they are not in
   `headings` and have to be added by hand. */
if (p.faqs.length) {
  toc.push({ id: 'faq', text: 'Frequently asked questions', level: 2 });
  p.faqs.forEach(f => toc.push({ id: slugify(f.q), text: f.q, level: 3 }));
}

const words = entry.body?.split(/\s+/).length ?? 0;
const readTime = Math.max(2, Math.round(words / 220));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

/* Two other guides, preferring the same topic. */
const related = posts
  .filter(x => x.id !== entry.id)
  .sort((a, b) => (Number(b.data.category === p.category) - Number(a.data.category === p.category))
                || b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const crumbSchema = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement: [
  { '@type':'ListItem', position:1, name:'Home', item: site.domain },
  { '@type':'ListItem', position:2, name:'Blogs', item: `${site.domain}/blogs/` },
  { '@type':'ListItem', position:3, name:p.title, item: url }]};
const articleSchema = { '@context':'https://schema.org', '@type':'BlogPosting',
  headline: p.title, description: p.excerpt, datePublished: p.date, dateModified: p.date,
  image: `${site.domain}${fig.src}`, inLanguage: 'en', wordCount: words,
  author: { '@type':'Organization', name: site.name, url: site.domain },
  publisher: { '@type':'Organization', name: site.name, url: site.domain },
  mainEntityOfPage: { '@type':'WebPage', '@id': url } };
const faqSchema = p.faqs.length ? { '@context':'https://schema.org', '@type':'FAQPage',
  mainEntity: p.faqs.map(f => ({ '@type':'Question', name:f.q,
    acceptedAnswer:{ '@type':'Answer', text:f.a } })) } : null;
---
<Base title={p.title + ' | Buggy Rents'} description={p.excerpt}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

  <!-- 1 hero -->
  <section class="ar__hero">
    <div class="bl__shell ar__hero-grid">
      <div class="ar__hero-copy">
        <nav class="bl__crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/blogs/">Blogs</a><span aria-hidden="true">/</span>
          <span aria-current="page">{p.title}</span>
        </nav>
        <p class="bl__eyebrow">{cat}</p>
        <h1 id="article-title">{p.title}</h1>
        <p class="ar__deck">{p.excerpt}</p>
        <div class="ar__meta" aria-label="Article details">
          <span>{fmt(p.date)}</span>
          <span>{readTime} min read</span>
          <span>Buggy Rents team</span>
        </div>
        <div class="ar__hero-actions">
          <a class="btn btn--primary btn--lg" href={waLink(p.helpMessage)}>Plan this ride</a>
          <a class="btn btn--ghost btn--lg" href="#article">Read guide</a>
        </div>
      </div>
      <div class="ar__hero-visual">
        <figure class="ar__hero-figure">
          <img src={fig.src} alt={fig.alt} width="1200" height="900" loading="eager" decoding="async" />
        </figure>
      </div>
    </div>
    <span class="ar__backdrop" aria-hidden="true">DESERT</span>
  </section>

  <!-- 2 article -->
  <div class="bl__shell ar__wrap">
    <aside class="ar__toc" aria-label="Table of contents">
      <div class="ar__panel">
        <p class="ar__panel-eyebrow">In this guide</p>
        <nav>
          {toc.map(t => (
            <a class={`ar__toc-link ar__toc-link--h${t.level}`} href={`#${t.id}`}>{t.text}</a>
          ))}
        </nav>
      </div>
    </aside>

    <article class="ar__body" id="article">
      <nav class="ar__toc-mobile" aria-label="Table of contents">
        <p class="ar__panel-eyebrow">In this guide</p>
        <ol>{toc.filter(t => t.level === 2).map(t => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
      </nav>

      {p.intro && <p set:html={p.intro} />}

      <h2 id="key-takeaways">Key takeaways</h2>
      <ul>{p.takeaways.map(t => <li set:html={t} />)}</ul>

      {/* Everything the client writes in the editor, including any comparison
          table, renders here. .ar__table-wrap used to be applied by hand around a
          structured table field; blog.css now styles tables inside .ar__body
          directly so a markdown table gets the same treatment. */}
      <Content />

      {p.faqs.length > 0 && (
        <>
          <h2 id="faq">Frequently asked questions</h2>
          {p.faqs.map(f => (
            <>
              <h3 id={slugify(f.q)}>{f.q}</h3>
              <p>{f.a}</p>
            </>
          ))}
        </>
      )}

      <p set:html={p.closing} />
    </article>

    <div class="ar__help">
      <aside class="ar__panel ar__panel--help" aria-label="Booking help">
        <p class="ar__panel-eyebrow">Need help choosing?</p>
        <h2>{p.helpTitle}</h2>
        <p>{p.helpText}</p>
        <a class="btn btn--primary" href={waLink(p.helpMessage)}>WhatsApp team</a>
      </aside>

      <aside class="ar__panel" aria-label="Related guides">
        <p class="ar__panel-eyebrow">Related guides</p>
        <div class="ar__related-list">
          {related.map(r => {
            const ri = img(r.data.image, r.data.subject);
            return (
              <a class="ar__related-card" href={`/blogs/${r.id}/`}>
                {/* Decorative: the title next to it is the accessible label for this link. */}
                <img src={ri.src} alt="" aria-hidden="true" width="72" height="56" loading="lazy" decoding="async" />
                <div>
                  <strong>{r.data.title}</strong>
                  <span>Read</span>
                </div>
              </a>
            );
          })}
        </div>
      </aside>
    </div>
  </div>

  <!-- 3 author -->
  <div class="ar__divider" aria-hidden="true"><span></span></div>
  <section class="ar__author">
    <div class="bl__shell ar__author-inner">
      <div class="ar__avatar" aria-hidden="true">BR</div>
      <div>
        <p class="ar__author-name">The Buggy Rents team</p>
        <p class="ar__author-bio">
          We run the base at Al Awir on the Dubai to Hatta road, with {site.fleetSize} vehicles
          and {site.guides} guides. Every price and age limit in this guide is what we charge
          and enforce, not an estimate.
        </p>
      </div>
    </div>
  </section>

  <!-- 4 final CTA -->
  <div class="ar__divider" aria-hidden="true"><span></span></div>
  <section class="ar__final">
    <div class="bl__shell ar__final-inner">
      <p class="bl__eyebrow">Ready to ride?</p>
      <h2>{p.finalH2}</h2>
      <p>{p.finalLede}</p>
      <div class="ar__final-actions">
        <a class="btn btn--primary btn--lg" href={waLink(p.helpMessage)}>Book on WhatsApp</a>
        <a class="btn btn--onDark btn--lg" href={p.helpHref}>{p.helpLinkLabel}</a>
      </div>
    </div>
  </section>
</Base>
